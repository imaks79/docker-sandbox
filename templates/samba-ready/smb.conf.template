[global]
   workgroup = WORKGROUP
   server string = docker-sandbox samba
   security = user
   map to guest = Bad User
   log file = /var/log/samba/log.%m
   max log size = 1000
   server min protocol = SMB2
   server smb encrypt = default

[workspace]
   path = __SAMBA_SHARE_PATH__
   browseable = yes
   writable = yes
   guest ok = no
   valid users = __SAMBA_USER__
   create mask = 0664
   directory mask = 0775
